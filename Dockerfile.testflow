# ================================================================
# Dockerfile.testflow
# 역할: test_flow FastAPI 서버를 실행할 컨테이너 환경을 만드는 설계도
# ================================================================

# ── 문서 파서 kordoc(Node.js) 설치 단계 ─────────────────────────
# package-lock.json 버전 그대로 설치하고, node 실행 파일과 함께 아래 단계로 복사한다.
FROM node:22-bookworm-slim AS kordoc
WORKDIR /kordoc
COPY test_flow/kordoc/package.json test_flow/kordoc/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund


FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# STT 긴 녹음 압축·분할에 ffmpeg가 필요하다.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# kordoc CLI는 node로 실행된다 (kordoc/node_modules/.bin/kordoc).
COPY --from=kordoc /usr/local/bin/node /usr/local/bin/node
COPY --from=kordoc /kordoc ./kordoc

# requirements만 먼저 복사해 Docker layer cache를 활용한다.
COPY test_flow/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# .env가 이미지에 들어가지 않도록 필요한 소스만 선별 복사한다.
COPY test_flow/*.py ./
COPY test_flow/stt_terms.json ./stt_terms.json
COPY test_flow/feature_chat ./feature_chat
COPY test_flow/internal_docs ./internal_docs

EXPOSE 8500

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8500"]
