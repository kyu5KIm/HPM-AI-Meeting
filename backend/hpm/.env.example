# backend/hpm/.env 예시
# 이 파일을 backend/hpm/.env 로 복사한 뒤 실제 값으로 채웁니다. (.env는 Git에 올리지 않음)
# docker-compose의 backend 서비스도 이 위치의 .env를 사용합니다.

# ── Django ───────────────────────────────────────────────────────
# 운영에서는 반드시 고유한 값으로 설정 (Jira OAuth state 서명에도 사용)
# 생성: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_USER_PASSWORD=change-me
FRONTEND_URL=http://localhost:5173

# ── DB: PostgreSQL (Supabase) ────────────────────────────────────
# Supabase 대시보드 > Connect > Session pooler 값을 그대로 사용
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=change-me
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
# Supabase는 require, SSL 없는 로컬 Postgres는 prefer 또는 disable
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# ── AI 서버 (test_flow FastAPI) ──────────────────────────────────
# 로컬에서 test_flow를 8500 포트로 띄운 경우. docker-compose에서는 자동으로 http://testflow:8500 사용
RUNPOD_CORE_BASE_URL=http://localhost:8500
RUNPOD_STT_BASE_URL=http://localhost:8500
RUNPOD_OCR_BASE_URL=http://localhost:8500
RUNPOD_PARSED_BASE_URL=http://localhost:8500
RAG_SERVER_URL=http://localhost:8500/chat

# ── Jira OAuth 2.0 (3LO) ─────────────────────────────────────────
# developer.atlassian.com/console/myapps > 앱 > Settings 의 값
# 앱 Permissions에 read:jira-work, write:jira-work, read:jira-user,
# read:board-scope:jira-software, write:issue:jira-software 가 켜져 있어야 함
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# 앱 Authorization > Callback URL과 끝의 / 까지 똑같이
JIRA_REDIRECT_URI=http://localhost:8000/api/jira/callback/
JIRA_PROJECT_KEY=HPM

# Jira REST (선택, OAuth를 쓰면 비워둬도 됨)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=

# ── AWS (SES 메일 발송, S3 파일 저장) ────────────────────────────
AWS_REGION=ap-northeast-2
SES_FROM_EMAIL=noreply@example.com
# S3를 쓰지 않으면 비워 두세요 (업로드 파일이 로컬 media 폴더에 저장됨)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2
# 기본값: https://s3.<AWS_S3_REGION_NAME>.amazonaws.com (S3 호환 스토리지일 때만 설정)
# AWS_S3_ENDPOINT_URL=
# EC2 IAM 역할을 쓰지 않는 환경에서만 주석을 풀고 설정
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
