# OpenAI
TEST_FLOW_OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SEC=300

# Models
TEST_FLOW_LLM_MODEL_ID=gpt-5.6-luna
# GPT-5 계열 추론 강도: none, low, medium, high (none이면 temperature 적용)
TEST_FLOW_REASONING_EFFORT=low
TEST_FLOW_REASONING_EXTRA_TOKENS=4096
TEST_FLOW_OCR_MODEL_ID=gpt-5.6-luna
TEST_FLOW_STT_MODEL_ID=gpt-4o-transcribe-diarize
TEST_FLOW_EMBEDDING_PROVIDER=kure
TEST_FLOW_EMBEDDING_MODEL_ID=kure-v3
TEST_FLOW_RAG_ANSWER_PROVIDER=openai
TEST_FLOW_RAG_ANSWER_MODEL=gpt-5.6-luna
TEST_FLOW_RAG_EMBEDDING_PROVIDER=kure
TEST_FLOW_RAG_EMBEDDING_MODEL=kure-v3
# KURE-v3: 256~2048. 1024로 줄여도 점수의 99% 유지. 바꾸면 컬렉션을 새로 만들어야 한다.
EMBEDDING_DIMENSIONS=1024

# KURE API (https://kure.kullm.ai, GitHub 로그인으로 키 발급)
KURE_API_KEY=
KURE_BASE_URL=https://kure.kullm.ai/api/v1
# 기본 한도 60 RPM -> 요청 간격 1초. 원문 저장 동의(120 RPM) 시 0.5
KURE_MIN_INTERVAL_SEC=1.0
KURE_MAX_RETRIES=6

# Reranker: kure 또는 cohere
TEST_FLOW_RERANK_PROVIDER=kure
TEST_FLOW_RERANK_MODEL=kure-reranker-nano
RAG_RERANK_MAX_CHARS=4000
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Server/job settings
STT_JOB_WORKERS=1
OCR_JOB_WORKERS=1
INTERNAL_DOCS_JOB_WORKERS=1
MINUTES_JOB_WORKERS=1

# OCR settings
OCR_MAX_PDF_PAGES=10
OCR_RENDER_SCALE=2.0
OCR_PDF_TEXT_FIRST=true
OCR_MIN_DIRECT_TEXT_CHARS=80

# RAG/Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hpm_kure_chunks
QDRANT_COLLECTION_PROJECT_MODE=true
QDRANT_COLLECTION_PREFIX=hpm_project_kure
DOC_CHUNK_CHARS=1200
DOC_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_FETCH_LIMIT=30
RAG_MAX_CONTEXT_CHARS=6000

# 회의 준비자료의 뉴스 검색 (네이버 검색 API, 없으면 뉴스 없이 생성)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택: RAG 재정렬(rerank). 없으면 재정렬 없이 검색
COHERE_API_KEY=

# Parsed document ingest
LOCAL_PDF_ENABLE_TABLES=true
LOCAL_PDF_OCR_FALLBACK=true
LOCAL_PDF_MIN_PAGE_CHARS=30
PIPELINE_TIMEOUT_SEC=2400
CHUNK_SIZE=650
CHUNK_OVERLAP=120
CHUNK_VERSION=local_parent_child_650

# Django should point every AI URL to this one FastAPI server.
RUNPOD_CORE_BASE_URL=http://localhost:8500
RUNPOD_STT_BASE_URL=http://localhost:8500
RUNPOD_OCR_BASE_URL=http://localhost:8500
RUNPOD_PARSED_BASE_URL=http://localhost:8500
RAG_SERVER_URL=http://localhost:8500/chat
